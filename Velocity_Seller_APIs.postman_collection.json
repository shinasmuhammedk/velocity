{
	"info": {
		"_postman_id": "velocity-seller-api",
		"name": "Velocity Seller APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Seller Products",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://localhost:8080/api/seller/products",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"seller",
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "Create Seller Product",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Premium Membership\",\n    \"symbol\": \"PREM\",\n    \"status\": \"Active\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/seller/products",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"seller",
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Seller Stats",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://localhost:8080/api/seller/stats",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"seller",
						"stats"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Seller Activity",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
