				],
				"url": {
					"raw": "http://localhost:8080/api/seller/activity",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"seller",
						"activity"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "token",
			"value": "YOUR_JWT_TOKEN_HERE"
		}
	]
